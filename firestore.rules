rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // HELPERS
    // ============================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function hasProfile() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function role() {
      return hasProfile()
        ? (profile().get('active', true) == true ? profile().get('role', '') : '')
        : request.auth.token.get('role', '');
    }

    function isAdmin()       { return role() == 'ADMIN'; }
    function isEngineering() { return role() == 'ENGINEERING'; }
    function isPolice()      { return role() == 'POLICE'; }
    function isCallCenter()  { return role() == 'CALL_CENTER'; }

    function isStaff() {
      // Any of the four internal roles. No external/citizen accounts
      // exist in this system (§2.2) — everyone signed in is internal staff.
      return isAdmin() || isEngineering() || isPolice() || isCallCenter();
    }

    // ============================================================
    // USERS  (§3, Appendix A, FR-USR-1..3)
    // ============================================================
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin();
      allow delete: if false;                 // deactivate instead of deleting
    }

    // ============================================================
    // PARCEL REGISTRY  (§5.1, FR-PAR-1..4)
    // ============================================================
    match /parcels/{parcelId} {
      allow read: if isStaff();
      allow create, update: if isCallCenter() || isEngineering() || isAdmin();
      allow delete: if false; // parcels are never deleted, only closed (BR-2)
    }

    match /buildings/{buildingId} {
      allow read: if isStaff();
      allow create, update: if isCallCenter() || isEngineering() || isAdmin();
      allow delete: if false;
    }

    // ============================================================
    // INTAKE — cases, complaints, triage
    // (§6.1, §7.1, §7.1a, BR-2, BR-3, BR-5)
    // ============================================================
    match /cases/{caseId} {
      allow read: if isStaff();
      allow create: if isCallCenter() || isEngineering() || isAdmin();
      allow update: if (isCallCenter() || isEngineering() || isPolice() || isAdmin())
                && resource.data.status != 'CLOSED';
      allow delete: if false;
    }

    match /complaints/{complaintId} {
      allow read: if isStaff();
      allow create, update: if isCallCenter() || isEngineering() || isAdmin();
      allow delete: if false;
    }

    match /triage/{triageId} {
      allow read: if isStaff();
      allow create, update: if isEngineering() || isAdmin();
      allow delete: if false;
    }

    // ============================================================
    // REVIEW — reports, reviews  (§6.1, §7.3, BR-1, BR-6)
    // ============================================================
    match /reports/{reportId} {
      allow read: if isStaff();
      allow create, update: if isEngineering() || isAdmin();
      allow delete: if false;
    }

    match /reviews/{reviewId} {
      allow read: if isStaff();
      allow create, update: if isEngineering() || isAdmin();
      allow delete: if false;
    }

    // ============================================================
    // ACTIONS — decisions, notices  (§6.2–6.3, §7.4, §8, BR-1, BR-4)
    // ============================================================
    match /decisions/{decisionId} {
      allow read: if isStaff();
      allow create, update: if isEngineering() || isAdmin();
      allow delete: if false;

      // NOTE: BR-1 (SHORING_CONFIRM requires a prior SHORING_WARNING
      // notice on the same parcel) needs a cross-document lookup that's
      // fragile to express safely here — enforce it in a Cloud Function
      // trigger or your backend validation layer, not in security rules.
      // Rules are the last line of defense, not the place for
      // multi-document business logic.
    }

    match /notices/{noticeId} {
      allow read: if isStaff();
      allow create: if isEngineering() || isAdmin();
      allow update: if isStaff()
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pdfUrl']);
      allow delete: if false;
    }

    // ============================================================
    // EVACUATION  (§6.2, §7.5, BR-7)
    // ============================================================
    match /evacuationExecutions/{evacId} {
      allow read: if isStaff();
      allow create, update: if isPolice() || isEngineering() || isAdmin();
      allow delete: if false;
    }

    // ============================================================
    // SITE VISITS  (§7.8, FR-DASH-3/4)
    // ============================================================
    match /siteVisits/{visitId} {
      allow read: if isStaff();
      allow create, update: if isEngineering() || isPolice() || isAdmin();
      allow delete: if false;
    }

    // ============================================================
    // ASSESSMENT, RESTORATION & FUNDING  (§6.4–6.5, BR-8, BR-10)
    // ============================================================
    match /assessments/{assessmentId} {
      allow read: if isStaff();
      allow create, update: if isEngineering() || isAdmin();
      allow delete: if false;
    }

    match /restorationStudies/{studyId} {
      allow read: if isStaff();
      allow create, update: if isEngineering() || isAdmin();
      allow delete: if false;
    }

    match /fundingCandidates/{fcId} {
      allow read: if isStaff();
      allow create, update: if isEngineering() || isAdmin();
      allow delete: if false;
    }

    // ============================================================
    // DEMOLITION  (§6.6, §7.7, BR-9)
    // ============================================================
    match /demolitionOrders/{orderId} {
      allow read: if isStaff();
      // Police post the notice and record execution; Engineering assigns
      // the contractor (§7.7, Appendix A).
      allow create, update: if isPolice() || isEngineering() || isAdmin();
      allow delete: if false;
    }

    // ============================================================
    // LEGACY IMPORT  (§7.9, BR-1, FR-IMP-1..3) — Admin only
    // ============================================================
    match /importBatches/{batchId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }
    match /importRows/{rowId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // ============================================================
    // ATTACHMENTS  (§7.11, FR-AUD-1)
    // ============================================================
    match /attachments/{attachmentId} {
      allow read: if isStaff();
      allow create: if isStaff(); // any role may attach a photo/PDF to a record
      allow update, delete: if false; // evidentiary — never edited or removed
    }

    // ============================================================
    // AUDIT LOG  (NFR-3, FR-AUD-2/3) — read-only from the client
    // ============================================================
    match /auditLogs/{logId} {
      allow read: if isEngineering() || isAdmin();
      allow create: if isStaff();
      allow update, delete: if false;   // immutable once written
    }

    // ============================================================
    // REFERENCE DATA — templates, default follow-up periods
    // (§7.12, FR-USR-3, BR-4)
    // ============================================================
    match /noticeTemplates/{templateId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }
    match /settings/{settingId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

   match /settings/{docId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // Notice templates + immutable versions (FR-ACT-2, FR-USR-3).
    match /noticeTemplates/{type} {
      allow read: if isStaff();
      allow write: if isAdmin();
      match /versions/{version} {
        allow read: if isStaff();
        allow create: if isAdmin();
        allow update, delete: if false;       // saved versions never change
      }
    }

    // Legacy import (§7.9). Administrator only.
    match /importBatches/{id} {
      allow read, create, update: if isAdmin();
      allow delete: if false;
    }
    match /importRows/{id} {
      allow read, create, update: if isAdmin();
      allow delete: if false;
    }

    // Deny everything not explicitly listed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}