rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() { return request.auth != null; }
    function role() { return isSignedIn() ? request.auth.token.role : null; }
    function isAdmin()       { return role() == 'ADMIN'; }
    function isEngineering() { return role() == 'ENGINEERING'; }
    function isPolice()      { return role() == 'POLICE'; }
    function isCallCenter()  { return role() == 'CALL_CENTER'; }
    function isStaff() {
      return isAdmin() || isEngineering() || isPolice() || isCallCenter();
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }
    function isPdf() {
      return request.resource.contentType == 'application/pdf';
    }
    function isSpreadsheet() {
      return request.resource.contentType.matches(
               'application/vnd.openxmlformats-officedocument.spreadsheetml.*')
             || request.resource.contentType == 'text/csv';
    }
    function underSizeLimit(mb) {
      return request.resource.size < mb * 1024 * 1024;
    }
    function isVideo() {
      return request.resource.contentType.matches('video/.*');
    }

    // Complaint photos — uploaded during intake (FR-INT-1)
    match /complaints/{complaintId}/{fileName} {
      allow read: if isStaff();
      allow create: if (isCallCenter() || isEngineering() || isAdmin())
                    && isImage() && underSizeLimit(10);
      allow update, delete: if false; // evidentiary — never replaced in place
    }

    // Site-visit / compliance-check photos (§7.8)
    match /siteVisits/{visitId}/{fileName} {
      allow read: if isStaff();
      allow create: if (isEngineering() || isPolice() || isAdmin())
                    && isImage() && underSizeLimit(10);
      allow update, delete: if false;
    }

    // Evacuation photos (BR-7)
    match /evacuations/{evacId}/{fileName} {
      allow read: if isStaff();
      allow create: if (isPolice() || isAdmin()) && isImage() && underSizeLimit(10);
      allow update, delete: if false;
    }

    // General parcel attachments — committee reports, external studies (§7.11)
    match /parcels/{parcelId}/attachments/{fileName} {
      allow read: if isStaff();
      allow create: if isStaff() && (isImage() || isVideo() || isPdf()) && underSizeLimit(50);
      allow update, delete: if false;
    }

    // Generated notices — Arabic RTL PDFs (§8, FR-ACT-1/2)
    match /notices/{noticeId}/{fileName} {
      allow read: if isStaff();
      // Generated server-side after a Decision is issued — never uploaded
      // directly by a client, so no client role can write here.
      allow write: if false;
    }

    // Legacy import spreadsheets (§7.9, FR-IMP-1) — Admin only
    match /imports/{batchId}/{fileName} {
      allow read: if isAdmin();
      allow create: if isAdmin() && isSpreadsheet() && underSizeLimit(15);
      allow update, delete: if false;
    }

    // Generated report exports — PDF/Excel (§9)
    match /reports/exports/{reportId}/{fileName} {
      allow read: if isStaff();
      allow write: if false; // generated server-side, same reasoning as notices
    }

    match /notices/{noticeId}/{fileName} {
      allow read: if isStaff();
      allow write: if isEngineering() || isAdmin();
    }

    // Deny everything not explicitly listed above.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}